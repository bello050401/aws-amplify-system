{
  "expo": {
    "name": "BELLO",
    "slug": "bello-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "商品写真の撮影とQRコード・バーコードの読み取りに使用します。",
        "NSPhotoLibraryUsageDescription": "在庫に登録する商品写真を選択するために使用します。"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/staff-app"
    },
    "plugins": [
      "expo-image",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "商品写真の撮影とQRコード・バーコードの読み取りに使用します。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "在庫に登録する写真を選択します。",
          "cameraPermission": "在庫の商品写真を撮影します。",
          "microphonePermission": false
        }
      ]
    ]
  }
}
