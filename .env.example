# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored on purpose.

# --- BASE API (https://developer.thebase.in) ---------------------------
# From your app's page in BASE Developers.
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
# Must exactly match the Callback URL registered for this app in BASE
# Developers. Local dev: http://localhost:3000/api/base/oauth/callback
# Production: https://<your-amplify-domain>/api/base/oauth/callback
BASE_REDIRECT_URI=http://localhost:3000/api/base/oauth/callback
# Space-separated OAuth2 scopes. Read-only product access is all this
# system needs.
BASE_SCOPES=read_items
# "true" forces the fixture-backed mock client regardless of the above.
# Leave unset/false once BASE_CLIENT_ID/SECRET are set and you've
# connected via /admin/settings — see docs/NOTES_BASE_API.md.
BASE_USE_MOCK=false

# --- ZAICO API (ZAICO → BELLO 一方向手動同期; GET専用) -------------------
# Server-only — never referenced from client code. See lib/zaico/client.ts:
# this client implements GET only, and the token is never logged/returned.
ZAICO_API_TOKEN=
# Override only if ZAICO's documented base URL changes.
# ZAICO_API_BASE_URL=https://web.zaico.co.jp/api/v1

# --- AI provider ---------------------------------------------------------
# "anthropic" (default) or "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Amplify Data (filled in automatically by `ampx sandbox` / deploy) --
# Not set by hand — amplify_outputs.json is generated by the Amplify CLI.
