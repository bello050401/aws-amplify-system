# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored on purpose.

# --- BASE API (https://developer.thebase.in) ---------------------------
# Confirm exact endpoint paths / scope names against the official docs
# before flipping BASE_USE_MOCK to "false". See docs/NOTES_BASE_API.md.
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_REFRESH_TOKEN=
# Set to "false" once the real BASE API client (lib/base/client.ts) has
# been wired up and verified against confirmed endpoints.
BASE_USE_MOCK=true

# --- AI provider ---------------------------------------------------------
# "anthropic" (default) or "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Amplify Data (filled in automatically by `ampx sandbox` / deploy) --
# Not set by hand — amplify_outputs.json is generated by the Amplify CLI.
