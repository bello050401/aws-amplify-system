# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://app:app@localhost:5432/furniture_listing"

# ── Mercari Shops API ────────────────────────────────────────
# "sandbox" または "production"。Phase 1では必ず sandbox を使用すること
# (docs/mercari-api.md 7節のチェックリストを満たすまで production へ切替しない)。
MERCARI_ENV=sandbox

# Personal API Access Token はこの .env には書かず、/settings/mercari 画面から
# 登録する（DBに暗号化して保存される）。ここでは暗号化キーのみを設定する。

# AES-256-GCM 用の暗号化キー。32バイトを base64 で。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# API呼び出しのタイムアウト(ms)・最大リトライ回数
MERCARI_TIMEOUT_MS=15000
MERCARI_MAX_RETRIES=3

# ── 画像ストレージ ────────────────────────────────────────────
# "local" | "s3" | "r2"
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# ローカル開発時、アップロード画像を配信するpublicなベースURL
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/uploads

# S3 / R2 用 (STORAGE_PROVIDER=s3 または r2 の場合に使用)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
