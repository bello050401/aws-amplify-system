# dependencies
node_modules/

# next.js
.next/
out/

# env — never commit secrets
.env
.env.*
!.env.example

# amplify
amplify/.amplify/
.amplify/
amplify_outputs.json
amplify_outputs.d.ts

# misc
.DS_Store
*.log
.vercel
*.tsbuildinfo

# ZAICO API reconnaissance output — real (if redacted) product data
# fetched from a live account; never committed regardless of where the
# script is run from. See zaico-verification/README.md.
zaico-verification/output/

# Playwright E2E artifacts (第五ラウンド P1-A) — local run output only.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# QA中に使う一時スクリプト(コミットしない)
.*.mjs

# ImageProcessingPanel実React境界試験ハーネスのesbuildビルド出力
# (scripts/qa-image-processing-harness/build.mjsで再生成できる)
scripts/qa-image-processing-harness/dist/

# E2E用のStaging認証情報（コミット禁止・使用後は削除）
.env.e2e.local

# Staging E2E: 保存済みのログイン状態はリポジトリ外(%LOCALAPPDATA%\BELLO\playwright)へ
# 置くが、万一ここへ出力した場合に備えて無視する。中身は生きたCognitoトークン。
*storage-state*.json

# Mercariブランド/カテゴリマスタのビルド成果物(scripts/generate-mercari-masters-data.cjs
# がdata/mercari-masters/*.csv(git追跡済み)から毎回再生成する。npm run
# build/dev/typecheckのpre*フックが自動実行するのでコミット不要)。
lib/listing/mercari/csv/generated/
