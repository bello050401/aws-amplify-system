# dependencies
node_modules/

# next.js
.next/
out/

# env — never commit secrets
.env
.env.*
!.env.example

# amplify
amplify/.amplify/
.amplify/
amplify_outputs.json
amplify_outputs.d.ts

# misc
.DS_Store
*.log
.vercel
*.tsbuildinfo

# ZAICO API reconnaissance output — real (if redacted) product data
# fetched from a live account; never committed regardless of where the
# script is run from. See zaico-verification/README.md.
zaico-verification/output/

# Playwright E2E artifacts (第五ラウンド P1-A) — local run output only.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# QA中に使う一時スクリプト(コミットしない)
.*.mjs

# E2E用のStaging認証情報（コミット禁止・使用後は削除）
.env.e2e.local

# Staging E2E: 保存済みのログイン状態はリポジトリ外(%LOCALAPPDATA%\BELLO\playwright)へ
# 置くが、万一ここへ出力した場合に備えて無視する。中身は生きたCognitoトークン。
*storage-state*.json
