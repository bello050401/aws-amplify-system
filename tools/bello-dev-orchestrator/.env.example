# BELLO Dev Orchestrator が読む環境変数（変数名と説明のみ。値は絶対に書かない）
#
# このファイルはコピーして使うためのものではありません。Orchestrator は .env を読まず、
# OS の環境変数だけを読みます。Windows では次のように設定してください。
#
#   [Environment]::SetEnvironmentVariable('OPENAI_API_KEY','<キー>','User')
#   powershell -ExecutionPolicy Bypass -File .\bello.ps1 restart
#
# 設定できたかの確認は bello.ps1 diagnose です。値は画面にもログにも出ません。

# --- AI 審査 (任意) -------------------------------------------------------
# 未設定でもシステムは動きます。設定するまで完了報告は「AI審査待ち」で止まり、
# 設定を促すユーザー TODO が 1 件だけ作られます。
OPENAI_API_KEY=
# 省略時は strict structured outputs に対応した既定モデルを使います。
OPENAI_MODEL=

# --- ダッシュボードの LAN 公開 (任意) --------------------------------------
# bello-orchestrator.config.json の dashboard.lanAccess を true にする場合のみ必須。
# 十分に長いランダム文字列を入れてください。未設定のまま lanAccess を有効にすると
# 起動を拒否します（無認証で LAN に出さないため）。
BELLO_DASHBOARD_TOKEN=

# --- 設定ファイルの場所を変える (任意) --------------------------------------
# 既定は tools/bello-dev-orchestrator/bello-orchestrator.config.json
BELLO_ORCHESTRATOR_CONFIG=
