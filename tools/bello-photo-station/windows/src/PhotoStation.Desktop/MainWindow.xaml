<Window x:Class="PhotoStation.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BELLO Photo Station" Height="620" Width="980" MinHeight="520" MinWidth="820" Background="#F4F6F8">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="BELLO Photo Station" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="SDの原本を変更せず、検証済みコピーを作成します" Margin="0,6,0,0" Foreground="#536171"/></StackPanel><Border DockPanel.Dock="Right" Background="#E4F4EA" CornerRadius="12" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="STAGING" Foreground="#08783E" FontWeight="Bold"/></Border></DockPanel>
    <Border Grid.Row="1" Margin="0,22,0,18" Background="White" CornerRadius="12" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="撮影カード" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding DetectedDriveText}" Margin="0,6,0,0" Foreground="#536171"/><TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#08783E"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="再検出" Command="{Binding RefreshCommand}" Padding="18,9" Margin="0,0,10,0"/><Button Content="検証コピー開始" Command="{Binding ImportCommand}" Padding="18,9" Background="#172033" Foreground="White"/></StackPanel></Grid></Border>
    <Border Grid.Row="2" Margin="0,0,0,18" Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="画像編集設定（安全な初期設定）" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding RecipeSummary}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#172033"/><TextBlock Text="{Binding ProcessingAvailabilityText}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#9A5B00" FontWeight="SemiBold"/></StackPanel></Border>
    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="取込履歴" FontWeight="Bold" FontSize="16"/><DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="作成日時 (UTC)" Binding="{Binding CreatedAtUtc}" Width="190"/><DataGridTextColumn Header="セッション" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="状態" Binding="{Binding State}" Width="170"/><DataGridTextColumn Header="端末" Binding="{Binding StationId}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border>
  </Grid>
</Window>
