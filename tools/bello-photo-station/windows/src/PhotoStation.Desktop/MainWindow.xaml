<Window x:Class="PhotoStation.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BELLO Photo Station r12" Icon="Assets/BelloPhotoStationRounded.png" Height="790" Width="1120" MinHeight="700" MinWidth="1020" Background="#F4F6F8">
 <Grid>
  <Grid x:Name="DesktopPanel" Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
      <StackPanel><TextBlock Text="{Binding AppHeading}" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="写真を仕上げて、選んだ保存先へ" Margin="0,6,0,0" Foreground="#536171"/></StackPanel>
      <Button DockPanel.Dock="Right" Content="WEBからログアウト" Click="SignOut_Click" IsEnabled="{Binding CanChangeDestination}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7"/>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,18,0,14" Background="White" CornerRadius="12" Padding="18">
      <StackPanel>
        <TextBlock Text="保存先" FontWeight="Bold" FontSize="16"/>
        <Grid Margin="0,10,0,0" IsEnabled="{Binding CanChangeDestination}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding DestinationNames}" SelectedIndex="{Binding DestinationIndex}" Padding="8" VerticalContentAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFolderDestination}" Margin="10,0" Padding="8" VerticalContentAlignment="Center" ToolTip="写真を保存するフォルダーのパス"/>
          <Button Grid.Column="2" Content="フォルダーを選ぶ…" Click="ChooseFolder_Click" IsEnabled="{Binding IsFolderDestination}" Padding="12,7"/>
        </Grid>
        <TextBlock Text="{Binding DestinationHelp}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#536171"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="WEBにログイン" Command="{Binding LoginCommand}" Padding="14,8" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#08783E" MaxWidth="680"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="0,0,0,14" Background="White" CornerRadius="12" Padding="18">
      <StackPanel>
        <DockPanel><TextBlock Text="撮影カード" FontWeight="Bold" FontSize="16"/><TextBlock Text="SDの原本は変更しません" HorizontalAlignment="Right" Foreground="#536171"/></DockPanel>
        <TextBlock Text="{Binding DetectedDriveText}" Margin="0,7,0,0" Foreground="#536171"/>
        <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanChangeDestination}">
          <Button Content="Lightroomを接続" Click="SetupLightroom_Click" Padding="12,8" Margin="0,0,8,0"/>
          <Button Content="編集設定…" Click="OpenSettings_Click" Padding="12,8" Margin="0,0,8,0"/>
          <Button Content="再検出" Command="{Binding RefreshCommand}" Padding="12,8" Margin="0,0,8,0"/>
          <Button Content="写真を取り込む" Command="{Binding ImportCommand}" Padding="16,8" Margin="0,0,8,0"/>
          <Button Content="位置を調整して保存" Command="{Binding UploadCommand}" Padding="18,8" Background="#08783E" Foreground="White"/>
        </WrapPanel>
        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#08783E"/>
        <TextBlock Text="{Binding RecipeSummary}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#536171"/>
        <TextBlock Text="{Binding OriginalRetentionHelp}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#536171"/>
        <Button Content="選択した商品の元画像を開く（7日間）" Command="{Binding OpenOriginalsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,8"/>
        <TextBlock Text="{Binding LightroomStatus}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#536171"/>
        <TextBlock Text="{Binding ProcessingAvailabilityText}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#9A5B00"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False"><TextBlock Text="取込履歴" FontWeight="Bold" FontSize="16"/><Button DockPanel.Dock="Right" Content="WEB保存済み写真を別バッチで再編集" Command="{Binding RedoCommand}" Padding="12,5" Margin="12,0,0,0"/></DockPanel>
        <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridTextColumn Header="作成日時 (UTC)" Binding="{Binding CreatedAtUtc}" Width="190"/><DataGridTextColumn Header="セッション" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="状態" Binding="{Binding DisplayState}" Width="130"/><DataGridTextColumn Header="端末" Binding="{Binding StationId}" Width="180"/></DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
  <ScrollViewer x:Name="TouchPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel Margin="20" MaxWidth="1280">
    <TextBlock Text="BELLO Photo Station r12" FontSize="27" FontWeight="SemiBold" Foreground="#172033"/>
    <TextBlock Text="SDカードを入れて、同じ商品の写真を選んでください" FontSize="17" Margin="0,6,0,18" TextWrapping="Wrap" Foreground="#536171"/>
    <Border Background="White" CornerRadius="14" Padding="18">
     <StackPanel>
      <TextBlock Text="{Binding DetectedDriveText}" FontSize="18" TextWrapping="Wrap"/>
      <UniformGrid Columns="2" Margin="0,14,0,12">
       <Button x:Name="TouchImportButton" Content="1　写真を取り込む" Command="{Binding ImportCommand}" Height="88" Margin="0,0,8,0" FontSize="20" FontWeight="SemiBold" Background="#E8EFFA" Foreground="#1B4F92"/>
       <Button x:Name="TouchSaveButton" Content="2　位置を調整して保存" Command="{Binding UploadCommand}" Height="88" Margin="8,0,0,0" FontSize="20" FontWeight="SemiBold" Style="{DynamicResource TouchSaveStyle}"/>
      </UniformGrid>
      <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" Foreground="#08783E" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding LightroomStatus}" FontSize="15" Foreground="#536171" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button Content="Lightroomを接続" Click="SetupLightroom_Click" IsEnabled="{Binding CanChangeDestination}" HorizontalAlignment="Left" MinHeight="52" Margin="0,10,0,0" Padding="20,8"/>
     </StackPanel>
    </Border>
    <Border Background="White" CornerRadius="14" Padding="18" Margin="0,14,0,0">
     <StackPanel>
      <TextBlock Text="取り込んだ商品" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="続きから加工する商品をタップして選択" FontSize="15" Foreground="#536171" Margin="0,5,0,10"/>
      <DataGrid x:Name="TouchHistory" Height="180" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
       <DataGrid.Columns><DataGridTextColumn Header="取込日時" Binding="{Binding CreatedAtLocal, StringFormat=MM/dd HH:mm}" Width="170"/><DataGridTextColumn Header="状態" Binding="{Binding DisplayState}" Width="*" MinWidth="200"/><DataGridTextColumn Header="端末" Binding="{Binding StationId}" Width="180"/></DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
    <Expander Header="保存先・ログイン・設定" Margin="0,14,0,0" Background="White" IsEnabled="{Binding CanChangeDestination}">
     <StackPanel Margin="10">
      <TextBlock Text="保存先" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox ItemsSource="{Binding DestinationNames}" SelectedIndex="{Binding DestinationIndex}"/>
      <TextBlock Text="{Binding DestinationHelp}" TextWrapping="Wrap" Foreground="#536171" Margin="0,8,0,8"/>
      <TextBox Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFolderDestination}"/>
      <WrapPanel Margin="0,8,0,8"><Button Content="保存フォルダーを選ぶ" Click="ChooseFolder_Click" IsEnabled="{Binding IsFolderDestination}" Margin="0,0,10,8"/><Button Content="WEBにログイン" Command="{Binding LoginCommand}" Margin="0,0,10,8"/><Button Content="WEBからログアウト" Click="SignOut_Click" Margin="0,0,10,8"/></WrapPanel>
      <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Foreground="#08783E" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding OriginalRetentionHelp}" TextWrapping="Wrap" Margin="0,8,0,8"/>
      <WrapPanel><Button Content="Lightroomを接続" Click="SetupLightroom_Click" Margin="0,0,10,8"/><Button Content="カードを再検出" Command="{Binding RefreshCommand}" Margin="0,0,10,8"/><Button Content="編集設定" Click="OpenSettings_Click" Margin="0,0,10,8"/><Button Content="WEB保存済み商品を再編集" Command="{Binding RedoCommand}" Margin="0,0,10,8"/><Button Content="元画像の一時保管（7日間）" Command="{Binding OpenOriginalsCommand}" Margin="0,0,10,8"/></WrapPanel>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
