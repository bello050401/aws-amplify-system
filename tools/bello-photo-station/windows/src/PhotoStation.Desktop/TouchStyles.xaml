<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="Button"><Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="96"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style x:Key="TouchSaveStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#08783E"/><Setter Property="Foreground" Value="White"/>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#637082"/><Setter Property="Background" Value="#E2E8F0"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="17"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="19"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/></Style>
  <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBox"><Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/><Setter Property="ScrollViewer.PanningDeceleration" Value="0.001"/></Style>
  <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="52"/><Setter Property="FontSize" Value="16"/><Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/></Style>
  <Style TargetType="Expander"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="8"/></Style>
</ResourceDictionary>
